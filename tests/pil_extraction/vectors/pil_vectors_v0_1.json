      "url": "https://example.com/item/playstation-5",
      "utc_year": 2026,
      "html": "<html><body><div class=\"card\"><h1>PlayStation 5 Console</h1><span class=\"old\">$ 599</span><span class=\"new\">$ 499</span></div></body></html>"
    },
    "expected": {
      "pil_extraction_status": "INVALID_PAGE_UNIT"
    }
  },
